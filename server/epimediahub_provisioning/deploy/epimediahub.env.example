# Copy to /etc/epimediahub/provisioning.env and replace every CHANGE_ME value.
EPIMEDIAHUB_PUBLIC_URL=https://setup.epimediahub.com
EPIMEDIAHUB_DATA_DIR=/var/lib/epimediahub
EPIMEDIAHUB_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_API_TOKEN
EPIMEDIAHUB_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
EPIMEDIAHUB_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SESSION_SECRET
PORT=8787
