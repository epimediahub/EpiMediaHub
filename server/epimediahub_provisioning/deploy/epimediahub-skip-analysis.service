[Unit]
Description=EpiMediaHub private chapter and intro audio analysis
After=network-online.target epimediahub-provisioning.service
Wants=network-online.target

[Service]
Type=oneshot
User=epimediahub
Group=epimediahub
WorkingDirectory=/opt/epimediahub/provisioning
EnvironmentFile=/etc/epimediahub/provisioning.env
ExecStart=/opt/epimediahub/provisioning/.venv/bin/python skip_analysis_worker.py --batch --max-jobs 4 --max-seconds 600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=256M
CPUQuota=50%
TimeoutStartSec=900
UMask=0077

[Install]
WantedBy=multi-user.target
