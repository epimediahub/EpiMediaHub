[Unit]
Description=EpiMediaHub series progress snapshot
After=epimediahub-provisioning.service
[Service]
Type=oneshot
User=epimediahub
Group=epimediahub
WorkingDirectory=/opt/epimediahub/provisioning
EnvironmentFile=/etc/epimediahub/provisioning.env
ExecStart=/opt/epimediahub/provisioning/.venv/bin/python skip_progress_worker.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
MemoryMax=128M
CPUQuota=25%
TimeoutStartSec=120
UMask=0077
